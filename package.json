        "discord.js": "^14.18.0",
        "dotenv": "^16.4.7",
        "node-cron": "^3.0.3",
        "node-fetch": "^3.3.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.0.0",
        "spotify-web-api-node": "^5.0.2",
        "sql.js": "^1.12.0",
        "vite": "^6.0.0",
        "wordnik-api": "^0.1.5"
    },
    "devDependencies": {
        "@types/node": "^22.10.7",
        "@types/node-cron": "^3.0.11",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/spotify-web-api-node": "^5.0.11",
        "@types/sql.js": "^1.4.9",
