    "version": "1.0.0",
    "description": "Yousoro~! Discord Bot",
    "main": "dist/index.js",
    "scripts": {
        "build": "npm run build:web && tsc",
        "build:server": "tsc",
        "build:web": "vite build --config web/vite.config.mjs",
